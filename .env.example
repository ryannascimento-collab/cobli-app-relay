# Modelo das variáveis de ambiente do relay. NÃO coloque valores reais aqui.
# Os valores reais são cadastrados na Vercel (Project > Settings > Environment Variables).
# Ainda não são usadas: a rota de capturas não foi implementada.

# Endereço do projeto Supabase NA NUVEM (não é o Supabase do servidor da Produção).
SUPABASE_URL=
# Chave de serviço desse mesmo projeto. Sensível: só na Vercel.
SUPABASE_SERVICE_ROLE_KEY=
